--- a/netstack2/http_handler.go
+++ b/netstack2/http_handler.go
@@ -20,6 +20,7 @@ import (
 	"time"
 
 	"github.com/fosrl/newt/logger"
+	"golang.org/x/net/http2"
 	"gvisor.dev/gvisor/pkg/tcpip/stack"
 )
 
@@ -246,9 +247,27 @@ func (h *HTTPHandler) HandleConn(conn net.Conn, rule *SubnetRule) {
 				conn.Close()
 				return
 			}
-			// tls.Server wraps the raw conn; the TLS handshake is deferred until
-			// the first Read, which the http.Server will trigger naturally.
-			effectiveConn = tls.Server(conn, tlsCfg)
+			tlsConn := tls.Server(conn, tlsCfg)
+			if err := tlsConn.Handshake(); err != nil {
+				logger.Warn("HTTP handler: TLS handshake failed for connection from %s: %v", conn.RemoteAddr(), err)
+				conn.Close()
+				return
+			}
+
+			if tlsConn.ConnectionState().NegotiatedProtocol == "h2" {
+				ctx := context.WithValue(context.Background(), connCtxKey{}, rule)
+				ctx = context.WithValue(ctx, connTLSKey{}, true)
+
+				go (&http2.Server{}).ServeConn(tlsConn, &http2.ServeConnOpts{
+					Context:    ctx,
+					BaseConfig: h.server,
+					Handler:    http.HandlerFunc(h.handleRequest),
+				})
+
+				return
+			}
+
+			effectiveConn = tlsConn
 		}
 	}
 
