[req]
distinguished_name = dn
prompt = no
req_extensions = req_ext

[dn]
C = {{ omni_cert_country }}
O = {{ omni_cert_organization }}
CN = {{ omni_endpoint }}

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = {{ omni_endpoint }}
DNS.2 = {{ omni_auth_endpoint }}
IP.1 = 127.0.0.1
IP.2 = {{ omni_advertised_ip }}
IP.3 = {{ omni_private_ip }}

