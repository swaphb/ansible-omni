---
# This file contains 1Password secret references, not secrets. Copy it to
# group_vars/omni.1password.yml, replace <vault> and <item>, then use the
# 1Password VS Code extension to insert and manage references. Keep this
# reference file in Git; never commit the rendered group_vars/omni.yml.
#
# Create the item and fields with:
#   scripts/bootstrap-1password.sh --vault "<vault>" --item "<item>"
#
# The field labels exactly match these variable names. Do not rename fields
# after deployment: their names are part of the op:// references.
omni_install_docker: op://<vault>/<item>/omni_install_docker
omni_version: "op://<vault>/<item>/omni_version"
omni_dex_version: "op://<vault>/<item>/omni_dex_version"
omni_base_dir: "op://<vault>/<item>/omni_base_dir"
omni_endpoint: "op://<vault>/<item>/omni_endpoint"
omni_auth_endpoint: "op://<vault>/<item>/omni_auth_endpoint"
omni_advertised_ip: "op://<vault>/<item>/omni_advertised_ip"
omni_private_ip: "op://<vault>/<item>/omni_private_ip"
omni_admin_email: "op://<vault>/<item>/omni_admin_email"
omni_admin_password: "op://<vault>/<item>/omni_admin_password"
omni_oidc_client_id: "op://<vault>/<item>/omni_oidc_client_id"
omni_oidc_client_secret: "op://<vault>/<item>/omni_oidc_client_secret"
omni_oidc_provider: "op://<vault>/<item>/omni_oidc_provider"
omni_pocketid_url: "op://<vault>/<item>/omni_pocketid_url"
omni_pocketid_bootstrap: op://<vault>/<item>/omni_pocketid_bootstrap
omni_pocketid_api_key: "op://<vault>/<item>/omni_pocketid_api_key"
omni_pocketid_client_name: "op://<vault>/<item>/omni_pocketid_client_name"
omni_pocketid_skip_consent: op://<vault>/<item>/omni_pocketid_skip_consent
omni_extra_ca_certificates: "op://<vault>/<item>/omni_extra_ca_certificates"
omni_eula_name: "op://<vault>/<item>/omni_eula_name"
omni_eula_email: "op://<vault>/<item>/omni_eula_email"
omni_ca_common_name: "op://<vault>/<item>/omni_ca_common_name"
omni_cert_country: "op://<vault>/<item>/omni_cert_country"
omni_cert_organization: "op://<vault>/<item>/omni_cert_organization"
omni_cert_valid_days: op://<vault>/<item>/omni_cert_valid_days
omni_add_host_entries: op://<vault>/<item>/omni_add_host_entries
omni_newt_enabled: op://<vault>/<item>/omni_newt_enabled
omni_newt_version: "op://<vault>/<item>/omni_newt_version"
omni_newt_pangolin_endpoint: "op://<vault>/<item>/omni_newt_pangolin_endpoint"
omni_newt_id: "op://<vault>/<item>/omni_newt_id"
omni_newt_secret: "op://<vault>/<item>/omni_newt_secret"
omni_newt_network_name: "op://<vault>/<item>/omni_newt_network_name"
omni_embedded_etcd: op://<vault>/<item>/omni_embedded_etcd
# Store a YAML list, for example '["https://etcd-1.internal:2379"]'.
omni_etcd_endpoints: op://<vault>/<item>/omni_etcd_endpoints
omni_external_etcd_ca: "op://<vault>/<item>/omni_external_etcd_ca"
omni_external_etcd_client_cert: "op://<vault>/<item>/omni_external_etcd_client_cert"
omni_external_etcd_client_key: "op://<vault>/<item>/omni_external_etcd_client_key"
