---
omni_endpoint: omni.internal
omni_auth_endpoint: auth.internal
omni_advertised_ip: 192.0.2.10
omni_private_ip: 192.0.2.10
omni_admin_email: admin@omni.internal
# Keep these pins synchronized with the matching README entries. The scheduled
# Gitea Action proposes release updates in a reviewable pull request.
omni_version: v1.12.4
omni_dex_version: v2.41.1

# Store these with ansible-vault; do not commit real values.
omni_admin_password: CHANGE_ME
omni_oidc_client_secret: CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Authentication provider: "dex" (bundled default) or "pocketid".
omni_oidc_provider: dex

# Pocket ID example. Use a stable client ID/secret. To create the client through
# Pocket ID's API, enable bootstrap and supply a vaulted admin API key.
omni_pocketid_url: https://id.example.com
omni_pocketid_bootstrap: false
omni_pocketid_api_key: ""
omni_pocketid_client_name: Sidero Omni
# If Pocket ID uses a private CA, vault/paste its PEM chain here.
omni_extra_ca_certificates: ""

# Optional: make Omni reachable through an existing Pangolin server via Newt.
# Create a Newt site in Pangolin first and copy its three values here.
omni_newt_enabled: false
omni_newt_pangolin_endpoint: https://pangolin.example.com
omni_newt_id: ""
omni_newt_secret: ""
# Required for Omni's HTTP/2 UI/API through Newt private HTTPS resources.
# This builds a pinned Newt derivative on the target during deployment.
omni_newt_http2_enabled: false
# Keep this source pin aligned with the supported Newt HTTP/2 patch.
omni_newt_source_commit: "329d6a1c6509aa0769fa5bf3b8437518fc4e83df"

# Optional: Pangolin machine client for subnet routing. This requires Newt
# mode, a Pangolin Machine Client, and routing from the Talos subnet to this
# host. See README before enabling it.
omni_pangolin_subnet_router_enabled: false
omni_pangolin_cli_version: "0.18.1"
omni_pangolin_machine_endpoint: https://pangolin.example.com
omni_pangolin_machine_id: ""
omni_pangolin_machine_secret: ""

# Setting both values accepts Sidero's EULA non-interactively. Leave both empty
# to accept it in the UI instead.
omni_eula_name: ""
omni_eula_email: ""
